# DAIR Containment Loop -- app-only credentials
# Copy to .env and populate. NEVER commit the populated file.

DAIR_TENANT_ID=00000000-0000-0000-0000-000000000000
DAIR_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Certificate credentials (PREFERRED)
# DAIR_CERT_PATH=/secure/path/containment-cert.pem
# DAIR_CERT_THUMBPRINT=ABCDEF0123456789ABCDEF0123456789ABCDEF01

# Client secret (fallback -- rotate aggressively, prefer the certificate above)
# DAIR_CLIENT_SECRET=

# Optional guardrail overlay (comma-separated). Config file is preferred.
# DAIR_PROTECTED_USERS=bg-admin-01@yourtenant.onmicrosoft.com,bg-admin-02@yourtenant.onmicrosoft.com
# DAIR_PROTECTED_DEVICES=DC01,DC02
